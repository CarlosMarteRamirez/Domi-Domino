# PostgreSQL connection string
DATABASE_URL="postgresql://domino:domino@localhost:5432/domino?schema=public"

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# Base URL of the app (used for invitation links and OAuth callbacks)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Server
PORT=3000
# Bind on all interfaces so other devices can connect (LAN / port-forward)
HOST=0.0.0.0

# --- Exponer en tu red (amigos en la misma WiFi) ---
# 1. Averigua tu IP local: ipconfig getifaddr en0   (Mac WiFi)
# 2. Pon esa IP aquí (ej. 192.168.1.50):
# AUTH_URL="http://192.168.1.50:3000"
# NEXT_PUBLIC_APP_URL="http://192.168.1.50:3000"
#
# --- Exponer por internet (router / port forwarding) ---
# 1. En el router: reenvío de puerto TCP 3000 -> IP local de tu PC :3000
# 2. Averigua tu IP pública: curl ifconfig.me
# 3. Pon tu IP pública (o dominio) aquí:
# AUTH_URL="http://TU_IP_PUBLICA:3000"
# NEXT_PUBLIC_APP_URL="http://TU_IP_PUBLICA:3000"
